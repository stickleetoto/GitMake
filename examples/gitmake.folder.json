{
  "schema_version": 1,
  "repo": {
    "name": "GitMake-Folder-Demo",
    "description": "Example folder-mode repository published by GitMake",
    "visibility": "private"
  },
  "source": {
    "folder": "."
  },
  "git": {
    "branch": "main",
    "initial_commit_message": "Initial commit",
    "commit_message": "Update GitMake-Folder-Demo"
  },
  "sync": {
    "mode": "managed",
    "protected_paths": [
      ".github/**",
      ".gitmake/**"
    ]
  },
  "security": {
    "secret_scan": true,
    "allow_secret_paths": [],
    "warn_file_bytes": 52428800,
    "max_git_file_bytes": 99614720
  },
  "release": {
    "enabled": false
  }
}
